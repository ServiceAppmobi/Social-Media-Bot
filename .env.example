# ==========================================
# KONFIGURACJA BOTA SERVICEAPP (BR & MX)
# ==========================================

APP_NAME=ServiceApp
APP_URL=https://serviceapp.mobi

# ------------------------------------------
# POWIADOMIENIA E-MAIL (Resend API)
# ------------------------------------------
RESEND_API_KEY=
EMAIL_RECIPIENT=karolak.pawel@gmail.com
EMAIL_SENDER=onboarding@resend.dev

# Fallback SMTP (opcjonalne, jeśli nie używasz RESEND_API_KEY)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ------------------------------------------
# POWIADOMIENIA PUSH NA IPHONE (Opcjonalne)
# ------------------------------------------
# Opcja A: Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcja B: ntfy (darmowa aplikacja iOS z powiadomieniami Push)
NTFY_TOPIC=

# ------------------------------------------
# AI / GOOGLE GEMINI API (Opcjonalne)
# ------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------
# HARMONOGRAM / ODŚWIEŻANIE
# ------------------------------------------
POLL_INTERVAL_SECONDS=1800
